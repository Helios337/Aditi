# Copy to .env at repo root for Docker Compose:
#   cp .env.example .env
#
# For local dev without Docker, also copy:
#   cp .env backend/.env
#   cp frontend/.env.local.example frontend/.env.local  # then edit

# --- Supabase (backend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Supabase (frontend — baked into Next.js at build time) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# --- App ---
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=you@example.com
STORAGE_BUCKET=question-images
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false

# Docker only: server-side Supabase URL (browser still uses NEXT_PUBLIC_SUPABASE_URL).
# Local Supabase: http://host.docker.internal:54321
# Hosted Supabase: same as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL_INTERNAL=
